{
  "name": "skill-cli-ai",
  "version": "0.1.1",
  "description": "Curated catalog + CLI for searching, reviewing, and installing AI agent skills",
  "type": "module",
  "bin": {
    "skill-cli": "src/cli.js"
  },
  "files": [
    "src/",
    "skills-core/",
    "README.md",
    "LICENSE",
    "docs/INSTALL.md",
    "docs/CATEGORIES.md",
    "docs/LICENSES.md",
    "docs/BUILDING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dondex452/skill-cli.git"
  },
  "homepage": "https://dondex452.github.io/skill-cli/",
  "bugs": {
    "url": "https://github.com/Dondex452/skill-cli/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "cli",
    "claude",
    "opencode",
    "gemini",
    "cursor"
  ],
  "scripts": {
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:categories-doc": "node scripts/taxonomy.mjs --docs",
    "scan:threats": "node scripts/scan-threats.mjs",
    "sanity-check": "node scripts/sanity-check.mjs",
    "test": "node --test tests/catalog.test.mjs tests/cli.test.mjs tests/fetch.test.mjs tests/install.test.mjs tests/search.test.mjs tests/taxonomy.test.mjs",
    "prepublishOnly": "npm test && npm run sanity-check"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
